# --- copy to .env.local and fill in ---

# URL of the Python chord-recognition service (engine/)
ENGINE_URL=http://localhost:8000

# Set to 1 to bypass the engine and serve sample data (useful for UI work)
ENGINE_MOCK=0

# Secret for signing session JWTs. Generate one: openssl rand -base64 32
AUTH_SECRET=

# Base URL of this app — used to build OAuth redirect URIs and reset links.
OAUTH_REDIRECT_BASE=http://localhost:3000

# --- Social login (optional; buttons are disabled until filled) ---
# Google:   https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: <OAUTH_REDIRECT_BASE>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps  (Facebook Login product)
#   Valid OAuth Redirect URI: <OAUTH_REDIRECT_BASE>/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- CAPTCHA (Cloudflare Turnstile) ---
# Leave blank to use Cloudflare's always-pass test keys (dev only).
# Real keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (OTP login + password reset) ---
# Leave SMTP_* blank to use a throwaway Ethereal inbox — nothing is delivered,
# but every send prints a preview URL to the server console (and the UI).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ChordScribe <no-reply@chordscribe.local>"

# --- .env (separate file, read by Prisma) ---
# DATABASE_URL="file:./dev.db"
